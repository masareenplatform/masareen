# ── Core ───────────────────────────────────────────────────────────────────────────
# MUST be set to a strong secret in any non-local environment. All services and the
# gateway derive JWT verification from this value, so it must be identical everywhere.
JWT_SECRET=masaren-alpha-change-me

# ── Payments (optional — leave blank to run in local-ledger / 501 mode) ─────────────
# Real Stripe PaymentIntents are created only when this is set. Without it, the
# payment-service records a local ledger entry and returns 501 for PSP capture.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vodafone Cash is delivered via the Paymob Accept API (wallet flow) below.
# Paymob (Egypt) — set these to enable real card + Vodafone Cash payments.
# Without them the payment-service still records the local ledger and returns
# 501 for PSP capture (no fabricated receipts).
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_VODAFONE_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_CURRENCY=EGP
PAYMOB_API_BASE=https://accept.paymob.com

# ── In-app coin (MASAREN Coin / MRC) ───────────────────────────────────────────────
# Default exchange rate: 1 EGP = N MRC. Overridable at runtime via the admin
# /api/v1/coin/exchange/rate endpoint.
MRC_PER_EGP=10.0

# ── Notifications (optional) ───────────────────────────────────────────────────────
# FCM HTTP v1 uses a service-account JSON. Without it, push returns honest `False`
# and the platform falls back to in-app/store-and-forward delivery.
FCM_SERVICE_ACCOUNT_JSON=

# ── AI / chat (optional) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
CREWAI_BROKER_URL=

# ── Hostname for the gateway when accessed from outside the compose network ────────
# Used by mobile/Web when not running through the nginx proxies.
PUBLIC_GATEWAY_URL=http://localhost:8080/api/v1
